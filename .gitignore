# dependencies
node_modules/
client/node_modules/

# build output
client/dist/
client/dist-android/
dist/
build/
*.tsbuildinfo

# android native build outputs (keep the project, ignore its build artefacts)
client/android/.gradle/
client/android/build/
client/android/app/build/
client/android/local.properties
client/android/.idea/
